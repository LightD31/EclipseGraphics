{
  "name": "EclipseGraphics",
  "version": "2.0.0",
  "description": "Habillage d'antenne pour OBS, modulable depuis une régie en français : un bundle NodeCG (graphiques, thèmes, animations, modules de données).",
  "private": true,
  "homepage": "https://github.com/LightD31/EclipseGraphics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightD31/EclipseGraphics.git"
  },
  "scripts": {
    "start": "node start.js",
    "panels": "node scripts/panels.js"
  },
  "devDependencies": {
    "nodecg": "^2.8.0"
  },
  "nodecg": {
    "compatibleRange": "^2.0.0",
    "dashboardPanels": [
      {
        "name": "regie",
        "title": "Régie",
        "file": "regie.html",
        "fullbleed": true
      },
      {
        "name": "antenne",
        "title": "À l'antenne",
        "file": "antenne.html",
        "width": 3,
        "headerColor": "#10173a"
      },
      {
        "name": "module-twitch",
        "title": "Chat Twitch",
        "file": "module-twitch.html",
        "width": 4,
        "headerColor": "#10173a"
      },
      {
        "name": "module-eclipse",
        "title": "Éclipse solaire",
        "file": "module-eclipse.html",
        "width": 3,
        "headerColor": "#10173a"
      },
      {
        "name": "module-flux",
        "title": "Flux de données",
        "file": "module-flux.html",
        "width": 3,
        "headerColor": "#10173a"
      },
      {
        "name": "module-meteo",
        "title": "Météo",
        "file": "module-meteo.html",
        "width": 3,
        "headerColor": "#10173a"
      },
      {
        "name": "module-chrono",
        "title": "Minuteurs",
        "file": "module-chrono.html",
        "width": 3,
        "headerColor": "#10173a"
      },
      {
        "name": "module-a350f",
        "title": "Premier vol A350F",
        "file": "module-a350f.html",
        "width": 4,
        "headerColor": "#10173a"
      },
      {
        "name": "module-programme",
        "title": "Programme",
        "file": "module-programme.html",
        "width": 3,
        "headerColor": "#10173a"
      },
      {
        "name": "module-score",
        "title": "Tableau de score",
        "file": "module-score.html",
        "width": 3,
        "headerColor": "#10173a"
      },
      {
        "name": "demande",
        "title": "Confirmer",
        "file": "dialog-demande.html",
        "width": 4,
        "dialog": true,
        "dialogButtons": [
          {
            "name": "Annuler",
            "type": "dismiss"
          },
          {
            "name": "OK",
            "type": "confirm"
          }
        ]
      },
      {
        "name": "reglages",
        "title": "Réglages du module",
        "file": "dialog-reglages.html",
        "width": 6,
        "dialog": true,
        "dialogButtons": [
          {
            "name": "Fermer",
            "type": "dismiss"
          }
        ]
      }
    ],
    "graphics": [
      {
        "file": "overlay.html",
        "width": 1920,
        "height": 1080,
        "singleInstance": false
      }
    ],
    "mount": [
      {
        "directory": "engine",
        "endpoint": "engine"
      },
      {
        "directory": "modules",
        "endpoint": "modules"
      }
    ],
    "assetCategories": [
      {
        "name": "images",
        "title": "Images de l'habillage",
        "allowedTypes": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "svg"
        ]
      },
      {
        "name": "videos",
        "title": "Vidéos de l'habillage",
        "allowedTypes": [
          "webm",
          "mp4"
        ]
      },
      {
        "name": "polices",
        "title": "Polices de l'habillage",
        "allowedTypes": [
          "woff2",
          "woff",
          "ttf",
          "otf"
        ]
      },
      {
        "name": "donnees",
        "title": "Fichiers de données (flux)",
        "allowedTypes": [
          "csv",
          "json",
          "xml",
          "rss",
          "txt"
        ]
      }
    ],
    "soundCues": [
      {
        "name": "entree",
        "defaultFile": "sounds/entree.mp3",
        "defaultVolume": 60
      },
      {
        "name": "flash",
        "defaultFile": "sounds/flash.mp3",
        "defaultVolume": 60
      },
      {
        "name": "point",
        "defaultFile": "sounds/point.mp3",
        "defaultVolume": 70
      },
      {
        "name": "alerte",
        "defaultFile": "sounds/alerte.mp3",
        "defaultVolume": 60
      }
    ]
  }
}

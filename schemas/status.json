{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "L'état du bundle",
  "description": "Pour les réglages de la Régie : liens OBS et Companion, pages connectées, relais des modules, journal.",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "boot": {
      "type": "number"
    },
    "now": {
      "type": "number"
    },
    "obs": {
      "type": "object"
    },
    "companion": {
      "type": "object"
    },
    "clients": {
      "type": "array"
    },
    "leaders": {
      "type": "object"
    },
    "log": {
      "type": "array"
    }
  }
}
